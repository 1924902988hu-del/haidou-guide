augment/1051.png","hexLabel":"顶级","opgg":false},{"id":1029,"name":"虚幻武器","rarity":"黄金","desc":"你的技能可施加攻击特效。每个目标有1秒冷却时间。","needsGameCheck":false,"icon":"assets/img/augment/1029.png","hexLabel":"顶级","opgg":false},{"id":1041,"name":"歌利亚巨人","rarity":"棱彩","desc":"体型变大，获得35%生命值和15%适应之力。","needsGameCheck":false,"icon":"assets/img/augment/1041.png","hexLabel":"顶级","opgg":false},{"id":1996,"name":"升级：耀光","rarity":"黄金","desc":"你的咒刃效果造成额外伤害并治疗你自身，治疗量相当于目标生命值的一定百分比。此外，获得250金币。","needsGameCheck":false,"icon":"assets/img/augment/1996.png","opgg":true},{"id":1138,"name":"渴血","rarity":"白银","desc":"获得15%全能吸血。","needsGameCheck":false,"icon":"assets/img/augment/1138.png","opgg":true},{"id":1353,"name":"坦克引擎","rarity":"黄金","desc":"参与击杀时，获得一个层数，使你的体型增大并提升最大生命值。阵亡时损失层数。","needsGameCheck":false,"icon":"assets/img/augment/1353.png","opgg":true},{"id":1058,"name":"秘术冲拳","rarity":"棱彩","desc":"攻击特效使你的各个技能的冷却时间缩减1.25秒。","needsGameCheck":false,"icon":"assets/img/augment/1058.png","opgg":true},{"id":2091,"name":"无尽大杀四方","rarity":"黄金","desc":"在战斗状态下，自动施放一次环形斧头挥舞从而造成物理伤害。被斧刃命中的敌人们受到额外伤害并治疗你。","needsGameCheck":false,"icon":"assets/img/augment/2091.png","opgg":true},{"id":2006,"name":"飞身踢","rarity":"棱彩","desc":"你的攻击和技能会处决低生命值的敌方英雄，从而击退并引发一次爆炸，同时治疗你自身。","needsGameCheck":false,"icon":"assets/img/augment/2006.png","opgg":true},{"id":1152,"name":"钢化你心","rarity":"黄金","desc":"任务：持有【心之钢】且层数在300层或以上。奖励：将你的【心之钢】层数乘以3。","needsGameCheck":false,"icon":"assets/img/augment/1152.png","opgg":true},{"id":1020,"name":"黎明使者的坚决","rarity":"黄金","desc":"在跌到50%生命值以下时，在3秒里持续回复共30%最大生命值。阵亡时或每45秒重置。","needsGameCheck":false,"icon":"assets/img/augment/1020.png","opgg":true},{"id":1322,"name":"罪恶快感","rarity":"黄金","desc":"参与击杀后，在4秒内提升移动速度和攻击速度。","needsGameCheck":false,"icon":"assets/img/augment/1322.png","opgg":true}],"combos":[{"augments":[{"id":1152,"name":"钢化你心","rarity":"黄金","desc":"任务：持有【心之钢】且层数在300层或以上。奖励：将你的【心之钢】层数乘以3。","needsGameCheck":false,"icon":"assets/img/augment/1152.png"},{"id":1181,"name":"重量级打击手","rarity":"白银","d