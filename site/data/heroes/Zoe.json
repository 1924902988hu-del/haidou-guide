s/img/augment/1053.png","hexLabel":"顶级","opgg":false},{"id":2132,"name":"术士果汁盒","rarity":"黄金","desc":"获得额外全能吸血。","needsGameCheck":false,"icon":"assets/img/augment/2132.png","hexLabel":"顶级","opgg":true},{"id":1335,"name":"夺金","rarity":"棱彩","desc":"用攻击或技能对一个英雄造成伤害时会造成额外魔法伤害，并为你提供金币和 移动速度。","needsGameCheck":false,"icon":"assets/img/augment/1335.png","hexLabel":"顶级","opgg":false},{"id":1030,"name":"尤里卡","rarity":"棱彩","desc":"获得相当于30%法术强度的技能急速。","needsGameCheck":false,"icon":"assets/img/augment/1030.png","opgg":true},{"id":1133,"name":"魔法飞弹","rarity":"黄金","desc":"造成技能伤害会对其发射3个飞弹，每个造成基于飞行距离的百分比最大生命值的真实伤害。","needsGameCheck":false,"icon":"assets/img/augment/1133.png","opgg":true},{"id":1097,"name":"巫师式思考","rarity":"白银","desc":"获得额外法术强度。","needsGameCheck":false,"icon":"assets/img/augment/1097.png","opgg":true},{"id":1211,"name":"杀戮时间到了","rarity":"黄金","desc":"在施放你的终极技能后，标记所有敌人并存储你对他们造成的伤害。当它结束时，引爆该伤害。","needsGameCheck":false,"icon":"assets/img/augment/1211.png","opgg":true},{"id":1073,"name":"暗影疾奔","rarity":"白银","desc":"在使用一个冲刺、闪烁或传送类技能或离开潜行状态之后，获得移动速度。","needsGameCheck":false,"icon":"assets/img/augment/1073.png","opgg":true},{"id":1113,"name":"老练狙神","rarity":"黄金","desc":"用一个非终极技能狙击一个敌人时，返还该技能80%冷却时间(周期性技能返还65%)。","needsGameCheck":false,"icon":"assets/img/augment/1113.png","opgg":true},{"id":2087,"name":"大法师","rarity":"棱彩","desc":"施放一个技能会返还另一个随机技能的花费，数额相当于30%原技能冷却时间。","needsGameCheck":false,"icon":"assets/img/augment/2087.png","opgg":true},{"id":1390,"name":"超凡邪恶","rarity":"黄金","desc":"在你用技能对敌人造成伤害时永久获得1法术强度。如果是作为你的第二个强化符文，则自带40法术强度。","needsGameCheck":false,"icon":"assets/img/augment/1390.png","opgg":true},{"id":1156,"name":"沃格勒特的巫师帽","rarity":"棱彩","desc":"立刻获得一个无用大棒。任务：持有灭世者的死亡之帽和中娅沙漏。奖励：获得沃格勒特的巫师帽。","needsGameCheck":false,"icon":"assets/img/augment/1156.png","opgg":true}],"combos":[{"augments":[{"id":1030,"name":"尤里卡","rarity":"棱彩","desc":"获得相当于30%法术强度的技能急速。","needsGameCheck":false,"icon":"assets/img/augment/1030.png"},{"id":1098,"name":"急急小子","rarity":"黄金","desc":"获得移动速度，相