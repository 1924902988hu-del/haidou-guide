ummonerFlash.png"},{"name":"标记","icon":"assets/img/spell/SummonerSnowball.png"}],[{"name":"闪现","icon":"assets/img/spell/SummonerFlash.png"},{"name":"引燃","icon":"assets/img/spell/SummonerDot.png"}]],"augments":[{"id":1152,"name":"钢化你心","rarity":"黄金","desc":"任务：持有【心之钢】且层数在300层或以上。奖励：将你的【心之钢】层数乘以3。","icon":"assets/img/augment/1152.png","hexScore":90.4,"hexLabel":"夯","opgg":false},{"id":1053,"name":"科学狂人","rarity":"棱彩","desc":"每次重生时，你的体型要么变大(获得适应之力和生命值)，要么变小(获得技能急速和移动速度)。","icon":"assets/img/augment/1053.png","hexScore":84.9,"hexLabel":"顶级","opgg":false},{"id":1420,"name":"咏叹奏鸣","rarity":"黄金","desc":"每10秒，以一个不断交替的旋律来自动施放坚毅咏叹调和迅捷奏鸣曲。坚毅咏叹调治疗附近友军并提供一个临时的护盾光环。迅捷奏鸣曲提供一个临时光环来提供额外移动速度。","icon":"assets/img/augment/1420.png","hexScore":84.2,"hexLabel":"顶级","opgg":false},{"id":1361,"name":"艾卡西亚的陷落","rarity":"棱彩","desc":"即刻：获得1个【斑比的熔渣】。任务：持有日炎圣盾和璀璨回响。奖励：将这些装备合成为虚空献祭。","icon":"assets/img/augment/1361.png","hexScore":82.3,"hexLabel":"顶级","opgg":false},{"id":1181,"name":"重量级打击手","rarity":"白银","desc":"你的攻击造成相当于你3.5%最大生命值的额外物理伤害。","icon":"assets/img/augment/1181.png","hexScore":81.4,"hexLabel":"顶级","opgg":true},{"id":1319,"name":"升级：献祭","rarity":"白银","desc":"【璀璨回响】和【日炎圣盾】每当有目标受到【献祭】效果影响时，提供12 金币 。获得250金币。","icon":"assets/img/augment/1319.png","hexScore":81.4,"hexLabel":"顶级","opgg":false},{"id":1080,"name":"会心防御","rarity":"白银","desc":"你可以使用你的暴击几率(最大50%几率)来进行会心防御，使你有一定几率来使所受伤害降低。获得25%暴击几率。","icon":"assets/img/augment/1080.png","hexScore":81.3,"hexLabel":"顶级","opgg":false},{"id":1170,"name":"万用瞄准镜","rarity":"白银","desc":"获得?攻击距离。","icon":"assets/img/augment/1170.png","hexScore":80.6,"hexLabel":"顶级","opgg":false},{"id":1243,"name":"质变：混沌","rarity":"棱彩","desc":"获得2个随机强化符文。","icon":"assets/img/augment/1243.png","hexScore":80.2,"hexLabel":"顶级","opgg":false},{"id":1401,"name":"生机迸发","rarity":"黄金","desc":"获得生机迸发作为一个召唤师技能。生机迸发会猛然提升你的体型，击飞附近的敌人们并提供最大生命值。","icon":"assets/img/augment/1401.png","hexScore":79.1,"hexLabel":"顶级","opgg":false},{"id":1329,"name":"史上最大雪球","rarity":"棱彩","desc":"你的雪球获得100技能急速。你的雪球现在变得非常大，并且可以穿过小兵。它会减速， 击飞英雄，并造成额外伤害。如果你没有雪球，则获得一个雪球。","icon":"assets/img/augment/1329.png","hexScore":78.9,"hexLabel":"顶级","opgg":false},{"id":1305,"name":"练腿日","rarity":"白银","desc":"获得50移动速度和40%减速抗性。","icon":"assets/img/augment/1305.png","hexScore":78.7,"hexLabel":"顶级","opgg":false},{"id":2091,"name":"无尽大杀四方","rarity":"黄金","desc":"在战斗状态下，自动施放一次环形斧头挥舞从而造成物理伤害。被斧刃命中的敌人们受到额外伤害并治疗你。","icon":"assets/img/augment/2091.png","opgg":true},{"id":1020,"name":"黎明使者的坚决","rarity":"黄金","desc":"在跌到50%生命值以下时，在3秒里持续回复共30%最大生命值。阵亡时或每45秒重置。","icon":"assets/img/augment/1020.png","opgg":true},{"id":2102,"name":"高压锅","rarity":"黄金","desc":"每一秒，对附近的敌方英雄们施加一层可叠加的灼烧，这个效果受益于你的最大生命值。任务：对敌方英雄造成灼烧伤害奖励：提升【高压锅】的规模和伤害，基于任务等级。","icon":"assets/img/augment/2102.png","opgg":true},{"id":1322,"name":"罪恶快感","rarity":"黄金","desc":"参与击杀后，在4秒内提升移动速度和攻击速度。","icon":"assets/img/augment/1322.png","opgg":true},{"id":1063,"name":"狂徒豪气","rarity":"黄金","desc":"在使用一次冲刺、闪烁或传送之后，你获得12护甲和魔法抗性，这个效果至多可叠加至5层。","icon":"assets/img/augment/1063.png","opgg":true},{"id":1001,"name":"泰坦的坚决","rarity":"棱彩","desc":"在承受或造成伤害时获得层数。每10层，获得适应之力、护甲、魔法抗性、体型和韧性。","icon":"assets/img/augment/1001.png","opgg":true},{"id":1138,"name":"渴血","rarity":"白银","desc":"获得15%全能吸血。","icon":"assets/img/augment/1138.png","opgg":true},{"id":1007,"name":"大力","rarity":"白银","desc":"获得20%攻击力。","icon":"assets/img/augment/1007.png","opgg":true},{"id":1079,"name":"战争交响乐","rarity":"棱彩","desc":"获得致命节奏和征服者基石符文。","icon":"assets/img/augment/1079.png","opgg":true}],"combos":[],"items":{"starter":[{"id":3177,"name":"守护者之刃","icon":"assets/img/item/3177.png"},{"id":1036,"name":"长剑","icon":"assets/img/item/1036.png"}],"core":[{"id":6697,"name":"狂妄","icon":"assets/img/item/6697.png"},{"id":6333,"name":"死亡之舞","icon":"assets/img/item/6333.png"},{"id":3036,"name":"多米尼克领主的致意","icon":"assets/img/item/3036.png"},{"id":2517,"name":"无穷饥渴","icon":"assets/img/item/2517.png"}],"boots":[{"id":3111,"name":"水银之靴","icon":"assets/img/item/3111.png"},{"id":3047,"name":"铁板靴","icon":"asset